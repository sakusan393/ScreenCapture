<Window x:Class="ScreenCapture.ThirdPartyLicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Third-party Licenses"
        Width="760"
        Height="600"
        MinWidth="520"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="0,0,0,10"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Text="Third-party software licenses"/>

        <TextBox x:Name="LicenseTextBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="12"/>

        <Button Grid.Row="2"
                Width="90"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Content="Close"
                IsCancel="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
