<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 単一EXEファイル発行設定 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- アプリケーション情報 -->
    <AssemblyName>ScreenCapture</AssemblyName>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>393</Authors>
    <Company>393</Company>
    <Product>ScreenCapture</Product>
    <Copyright>Copyright © 2026 393</Copyright>
    <Description>画面キャプチャツール - テキスト・画像追加・ペイント機能付き</Description>
    <RepositoryUrl>https://github.com/sakusan393/ScreenCapture</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- アプリケーションアイコン -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      WPF owns the process entry point and app.manifest declares the process-wide
      DPI mode required by Windows and the Store certification check. WFAC010 is
      specific to the WinForms bootstrap API, which this WPF application does not use.
    -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PixiEditor.ColorPicker" Version="3.4.2.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Fonts\NotoSansJP-Variable.ttf" />
    <None Remove="Fonts\OFL-NotoSansJP.txt" />
    <None Remove="Licenses\MIT-PixiEditor.ColorPicker.txt" />
    <Resource Include="Fonts\NotoSansJP-Variable.ttf" />
    <EmbeddedResource Include="Fonts\OFL-NotoSansJP.txt" />
    <EmbeddedResource Include="Licenses\MIT-PixiEditor.ColorPicker.txt" />
  </ItemGroup>

</Project>
